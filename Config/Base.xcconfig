// Settings shared by every target. Owner-specific values live in Local.xcconfig.

PRODUCT_BUNDLE_IDENTIFIER = app.menutop.mac
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
MACOSX_DEPLOYMENT_TARGET = 27.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES
DEAD_CODE_STRIPPING = YES

// Release builds ship notarized, and notarization rejects the debugger's get-task-allow
// entitlement that Xcode injects by default.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

#include? "Local.xcconfig"
